# 비밀키는 이 파일에 넣지 말고 Git 제외 .env에 주입합니다.
DB_URL=jdbc:postgresql://localhost:5433/ai_service
DB_USERNAME=ai
DB_PASSWORD=replace-with-local-ai-password
SERVER_PORT=8086
EUREKA_CLIENT_ENABLED=true
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
AI_CONSUMER_ENABLED=false
AI_WORKER_ENABLED=false
AI_OUTBOX_PUBLISHER_ENABLED=false
AI_VISION_ENABLED=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6.1-sol
PRODUCT_IMAGES_BUCKET=
PRODUCT_IMAGES_REGION=ap-northeast-2
AI_IMAGES_LOCAL=false
PRODUCT_IMAGES_ENDPOINT=
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=stockdrop-api
ACCOUNT_JWKS_URI=http://localhost:8080/.well-known/jwks.json

# GA/BigQuery는 별도 Google 설정을 마친 뒤 활성화합니다. OpenAI 키와 무관합니다.
AI_GA_ENABLED=false
AI_PERSONALIZATION_ENABLED=false
GA_BIGQUERY_PROJECT_ID=
GA_BIGQUERY_DATASET=
GA_BIGQUERY_LOCATION=
GA_PROPERTY_TIME_ZONE=Asia/Seoul
GA_MAXIMUM_BYTES_BILLED=1073741824
GA_MAXIMUM_ROWS=100000
# 로컬 ADC 또는 운영 Workload Identity Federation을 권장합니다. 자격 파일은 Git 제외 경로만 사용합니다.
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/google-credentials.json
# Account에서 별도로 등록할 Notification 서비스 토큰 주체입니다. 미설정이면 내부 검증 API는 차단됩니다.
NOTIFICATION_SERVICE_SUBJECT=
